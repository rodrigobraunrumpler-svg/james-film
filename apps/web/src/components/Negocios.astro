---
/**
 * El puente a la línea de PUBLICIDAD PARA NEGOCIOS.
 *
 * Es una sección corta en la portada, no la línea entera: quien entra buscando
 * un vídeo para su boda no quiere leerse cinco tarjetas de marketing, y quien
 * viene de un restaurante necesita ver en dos segundos que hay algo para él.
 * Lo demás vive en `/negocios`.
 */
import Icono, { type NombreIcono } from './Icono.astro';
import { NEGOCIOS, QUE_CREAMOS } from '../content/negocios';

const negrita = (t: string) => t.replace(/\*\*(.+?)\*\*/g, '<strong class="font-semibold">$1</strong>');
---

<section
  id="negocios"
  class="marco border-y border-line bg-surface py-10 lg:grid lg:grid-cols-[minmax(0,1fr)_minmax(0,1fr)] lg:items-center lg:gap-16 lg:py-16"
>
  <div class="flex flex-col gap-4">
    <p class="text-xs font-medium tracking-[0.18em] text-brass-600 uppercase">
      {NEGOCIOS.eyebrow}
    </p>
    <h2
      class="font-display text-[28px] leading-[1.06] font-extrabold tracking-[-0.025em] lg:text-[42px]"
    >
      {NEGOCIOS.titulo}
    </h2>
    <p class="max-w-[46ch] text-[17px] leading-snug" set:html={negrita(NEGOCIOS.entradilla)} />
    <a
      href="/negocios/"
      class="group flex h-13 w-fit items-center gap-2.5 rounded-control border border-brass-400 px-5 font-medium text-brass-200 transition-[transform,background-color] duration-150 hover:scale-[1.02] hover:bg-brass-relleno/8"
    >
      Ver qué hago para negocios
      <Icono
        nombre="flecha"
        tamano={17}
        clase="transition-transform duration-200 group-hover:translate-x-1"
      />
    </a>
  </div>

  <!--
    Los cinco del flyer, en tira deslizable bajo `lg`. Apilados serían cinco
    tarjetas más antes del calendario, y esta sección es un PUENTE: tiene que
    caber en un vistazo o estorba a quien vino por su boda.
  -->
  <ul
    class="sin-barra -mx-5 mt-5 flex list-none gap-3 overflow-x-auto px-5 pb-1 lg:mx-0 lg:mt-0 lg:grid lg:grid-cols-2 lg:px-0"
  >
    {
      QUE_CREAMOS.map((q, i) => (
        <li
          class="entra flex w-[68vw] shrink-0 flex-col gap-2 rounded-card border border-line bg-void p-4 sm:w-[42vw] lg:w-auto lg:p-5 [&:nth-child(5)]:lg:col-span-2"
          style={`--i: ${i}`}
        >
          <Icono nombre={q.icono as NombreIcono} tamano={20} grosor={1.8} clase="text-brass-400" />
          <p class="font-medium">{q.titulo}</p>
          <p class="text-sm text-ash">{q.texto}</p>
        </li>
      ))
    }
  </ul>
</section>
