---
/**
 * Los iconos, como SVG en línea y desde un MAPA ESTÁTICO.
 *
 * Sin librería: son veintitantos trazos y una dependencia de iconos son cientos
 * de KB para usar veinte. En línea escalan, se recolorean con `currentColor` y
 * no piden una petición más.
 *
 * El mapa es estático a propósito. Con resolución dinámica, un nombre con typo
 * cae al icono de reserva **en silencio** y deja un hueco en la web; así no
 * compila. Es la misma decisión que el admin tomó tras perder `Instagram` de
 * `lucide-react`.
 *
 * Todos en rejilla de 24, trazo 1.7 y extremos redondeados: un juego con dos
 * grosores distintos se lee como dos juegos.
 */
const TRAZOS = {
  play: '<rect x="2" y="4" width="20" height="16" rx="2.5"/><path d="m10 9 5 3-5 3V9Z"/>',
  reproducir: '<circle cx="12" cy="12" r="10"/><path d="m10 8 6 4-6 4V8Z"/>',
  caja: '<path d="M21 8 12 3 3 8v8l9 5 9-5V8Z"/><path d="m3 8 9 5 9-5M12 13v8"/>',
  calendario: '<rect x="3" y="5" width="18" height="16" rx="2.5"/><path d="M3 10h18M8 3v4M16 3v4"/>',
  chat: '<path d="M21 11.5a8.4 8.4 0 0 1-12.3 7.4L3 21l2.2-5.5A8.4 8.4 0 1 1 21 11.5Z"/>',
  persona: '<circle cx="12" cy="8" r="3.6"/><path d="M4.5 20a7.5 7.5 0 0 1 15 0"/>',
  personas:
    '<path d="M16 20v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="3.2"/><path d="M22 20v-2a4 4 0 0 0-3-3.8"/>',
  check: '<path d="M20 6 9 17l-5-5"/>',
  camara:
    '<path d="M14.5 4h-5L8 7H4a2 2 0 0 0-2 2v9a2 2 0 0 0 2 2h16a2 2 0 0 0 2-2V9a2 2 0 0 0-2-2h-4l-1.5-3Z"/><circle cx="12" cy="13" r="3.5"/>',
  rayo: '<path d="M13 2 3 14h8l-1 8 10-12h-8l1-8Z"/>',
  barras: '<path d="M4 20V10M10 20V4M16 20v-7M22 20H2"/>',
  reloj: '<circle cx="12" cy="12" r="9"/><path d="M12 7v5l3 2"/>',
  ubicacion: '<path d="M20 10c0 6-8 12-8 12S4 16 4 10a8 8 0 0 1 16 0Z"/><circle cx="12" cy="10" r="2.8"/>',
  flecha: '<path d="M5 12h14M13 6l6 6-6 6"/>',
  atras: '<path d="M19 12H5M11 18l-6-6 6-6"/>',
  abajo: '<path d="M12 5v14M6 13l6 6 6-6"/>',
  movil: '<rect x="6" y="2" width="12" height="20" rx="2.5"/><path d="M10 6h4"/>',
  video: '<path d="M4 5h16v14H4z"/><path d="m10 9 5 3-5 3V9Z"/>',
  descarga: '<path d="M12 3v12M8 11l4 4 4-4M4 20h16"/>',
  ojo: '<path d="M2 12s3.6-7 10-7 10 7 10 7-3.6 7-10 7-10-7-10-7Z"/><circle cx="12" cy="12" r="2.6"/>',
  menu: '<path d="M4 7h16M4 12h16M4 17h16"/>',
  sol: '<circle cx="12" cy="12" r="4"/><path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"/>',
  luna: '<path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8Z"/>',
  cerrar: '<path d="M18 6 6 18M6 6l12 12"/>',
  tiktok: '<path d="M9 12a4 4 0 1 0 4 4V3c.7 2 2.4 3.4 4.5 3.6"/>',
  instagram:
    '<rect x="3" y="3" width="18" height="18" rx="5"/><circle cx="12" cy="12" r="3.8"/><circle cx="17.3" cy="6.7" r="0.9" fill="currentColor"/>',
  enlace: '<path d="M10 13a5 5 0 0 0 7 0l3-3a5 5 0 0 0-7-7l-1.5 1.5"/><path d="M14 11a5 5 0 0 0-7 0l-3 3a5 5 0 0 0 7 7L12.5 20"/>',
} as const;

export type NombreIcono = keyof typeof TRAZOS;

interface Props {
  nombre: NombreIcono;
  tamano?: number;
  /** El check y las flechas piden más cuerpo que un contorno. */
  grosor?: number;
  clase?: string;
}

const { nombre, tamano = 20, grosor = 1.7, clase = '' } = Astro.props;
---

<svg
  width={tamano}
  height={tamano}
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width={grosor}
  stroke-linecap="round"
  stroke-linejoin="round"
  class={clase}
  aria-hidden="true"
  set:html={TRAZOS[nombre]}
/>
