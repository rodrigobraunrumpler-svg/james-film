---
/**
 * `/sobre-mi` · la página de confianza.
 *
 * Quien llega aquí ya está considerando pagarle a un desconocido para que esté
 * diez horas dentro de la boda de su hija. No viene a que le convenzan de nada:
 * viene a decidir si se fía. Por eso no repite argumentos de venta — enseña la
 * cara, el proceso y el trabajo hecho, que es lo que contesta esa pregunta.
 *
 * **Se construye con lo que HAY**: la foto, su texto, los números derivados de
 * las galerías, las categorías, el proceso y los trabajos. Nada inventado y
 * ningún hueco esperando a un dato que no ha llegado — si algo falta, esa
 * pieza sencillamente no se pinta.
 */
import Layout from '../layouts/Layout.astro';
import Barra from '../components/Barra.astro';
import BarraPegada from '../components/BarraPegada.astro';
import Cta from '../components/Cta.astro';
import Icono, { type NombreIcono } from '../components/Icono.astro';
import Pie from '../components/Pie.astro';
import Testimonios from '../components/Testimonios.astro';
import { ENTREGABLES, PASOS, PISTAS } from '../content/copy';
import { datosDePortada } from '../lib/api';
import { fotosDe, videosDe } from '../lib/piezas';
import { degradado } from '../lib/degradado';
import { ESCONDER_SI_FALLA, SIZES, src, srcset, og } from '../lib/imagen';

const { ajustes, categorias, redes, galerias, testimonios, diferenciadores } =
  await datosDePortada();

const numero = ajustes.whatsappNumber;
const base = ajustes.whatsappMessage ?? '';
const display = ajustes.whatsappDisplay ?? numero;

/** El `**negrita**` del `aboutText`. Solo negrita, como manda el resaltado del flyer. */
const html = (ajustes.aboutText ?? '').replace(
  /\*\*(.+?)\*\*/g,
  '<strong class="font-semibold text-brass-400">$1</strong>',
);

/**
 * Los números salen del DATO, no de una constante: no pueden quedarse viejos.
 *
 * Y «reels entregados» cuenta VÍDEOS. Sumaba `mediaCount`, o sea que una tanda
 * de fotos engordaba la cifra que la página usa para presentarse.
 */
const reels = videosDe(galerias);
const fotos = fotosDe(galerias);
const cuantas = galerias.reduce<Record<string, number>>((acc, g) => {
  acc[g.category.slug] = (acc[g.category.slug] ?? 0) + 1;
  return acc;
}, {});
const conTrabajos = categorias.filter((c) => cuantas[c.slug]);

const CIFRAS = [
  { n: String(galerias.length), texto: 'eventos grabados', hay: galerias.length > 0 },
  { n: String(reels), texto: 'reels entregados', hay: reels > 0 },
  { n: String(fotos), texto: 'fotos entregadas', hay: fotos > 0 },
  { n: String(conTrabajos.length), texto: 'tipos de evento', hay: conTrabajos.length > 0 },
].filter((c) => c.hay);

const ICONOS: Record<string, NombreIcono> = {
  camera: 'camara',
  zap: 'rayo',
  users: 'personas',
  'bar-chart-3': 'barras',
  clock: 'reloj',
  'map-pin': 'ubicacion',
  package: 'caja',
  link: 'enlace',
};

const destacadas = galerias.slice(0, 4);
---

{/* La foto pasa por `og()` como en el resto del sitio, no cruda: sin el helper
    se emitía el avatar tal cual —un PNG cuadrado— bajo el `og:image:width` de
    1200 y el `height` de 630 que el `Layout` declara fijos, así que la tarjeta
    salía recortada y las medidas eran mentira. Era la ÚNICA de las diez. */}
<Layout
  titulo={`Quién graba tu evento · ${ajustes.brandName}, video en Ayacucho`}
  descripcion={ajustes.aboutText?.replace(/\*\*/g, '').slice(0, 155) ?? ajustes.tagline}
  imagen={ajustes.photoUrl ? og(ajustes.photoUrl) : ajustes.ogImageUrl}
>
  <Barra
    {numero}
    {display}
    {base}
    anclas={['/trabajos/', '#paquetes', '/fechas-libres/', '/negocios/', '/sobre-mi/']}
    prefijo="/"
  />

  <main id="contenido" class="flex flex-col">
    <!-- ── Él ───────────────────────────────────────────────────────────── -->
    <section class="marco flex flex-col gap-6 py-7 lg:grid lg:grid-cols-[minmax(0,360px)_minmax(0,1fr)] lg:items-center lg:gap-16 lg:py-14">
      <div class="flex flex-col gap-4">
        <a href="/" class="flex min-h-12 w-fit items-center gap-2 text-ash lg:hidden">
          <Icono nombre="atras" tamano={18} />
          Volver al inicio
        </a>
        {/*
          La foto GRANDE y con proporción de retrato. En el bloque de la portada
          es un círculo de 78 px porque ahí acompaña; aquí es lo primero que se
          mira, y una cara pequeña no contesta la pregunta que trae a nadie a
          esta página. Sesgada arriba: `object-cover` centrado coge la corbata.
        */}
        <div
          class="relative aspect-4/5 max-h-[420px] w-full overflow-hidden rounded-panel border border-line lg:max-h-none"
          style="background: radial-gradient(120% 90% at 40% 30%, #453322 0%, #1b1410 60%, #080706 100%)"
        >
          {
            ajustes.photoUrl ? (
              <img
                src={src(ajustes.photoUrl)}
                srcset={srcset(ajustes.photoUrl)}
                sizes="(min-width: 1024px) 360px, 100vw"
                alt={`Foto de ${ajustes.brandName}`}
                fetchpriority="high"
                onerror={ESCONDER_SI_FALLA}
                class="absolute inset-0 h-full w-full object-cover object-[center_22%]"
              />
            ) : (
              <span
                class="absolute inset-0 flex items-center justify-center text-center text-sm"
                style="color: #b5aea4"
              >
                FOTO
                <br />
                DE JAMES
              </span>
            )
          }
        </div>
      </div>

      <div class="flex flex-col gap-5">
        <a href="/" class="hidden min-h-12 w-fit items-center gap-2 text-ash lg:flex">
          <Icono nombre="atras" tamano={18} />
          Volver al inicio
        </a>
        <div class="flex flex-col gap-1.5">
          <p class="text-xs font-medium tracking-[0.18em] text-brass-600 uppercase">Sobre mí</p>
          <h1
            class="font-display text-[34px] leading-[1.06] font-extrabold tracking-[-0.025em] lg:text-[52px]"
          >
            {ajustes.brandName}
          </h1>
          {
            ajustes.role && (
              <p class="text-sm tracking-[0.08em] text-ash uppercase">{ajustes.role} · Ayacucho</p>
            )
          }
        </div>

        {html && <p class="max-w-[54ch] text-lg leading-snug lg:text-[22px]" set:html={html} />}

        {
          ajustes.signatureUrl ? (
            <img
              src={src(ajustes.signatureUrl)}
              alt=""
              loading="lazy"
              onerror={ESCONDER_SI_FALLA}
              class="h-12 w-auto"
            />
          ) : (
            // La firma es SVG, no una fuente cursiva (§6). Marcador hasta que
            // James dé la suya.
            <svg width="146" height="50" viewBox="0 0 118 42" fill="none" aria-hidden="true">
              <path
                d="M8 32c6-14 10-22 14-22s2 12-2 16-8 2-6-6 8-14 14-14c4 0 4 6 1 12s-1 8 3 4 8-14 12-14 3 6 1 10-1 6 2 4 6-8 9-8 4 4 2 8"
                stroke="currentColor"
                class="text-brass-400"
                stroke-width="1.7"
                stroke-linecap="round"
                stroke-linejoin="round"
              />
            </svg>
          )
        }

        <Cta
          {numero}
          {base}
          texto={ajustes.ctaText ?? 'Escríbeme por WhatsApp'}
          fuente="footer"
          clase="lg:w-[400px]"
        />
      </div>
    </section>

    <!-- ── Los números, del dato ────────────────────────────────────────── -->
    {
      CIFRAS.length > 0 && (
        <div
          class="grid border-y border-line"
          style={`grid-template-columns: repeat(${CIFRAS.length}, minmax(0, 1fr))`}
        >
          {CIFRAS.map((c, i) => (
            <div
              class:list={[
                'entra flex flex-col items-center gap-0.5 px-2 py-5 lg:flex-row lg:justify-center lg:gap-2.5 lg:py-7',
                i > 0 && 'border-l border-line',
              ]}
              style={`--i: ${i}`}
            >
              <span class="font-display text-[30px] font-extrabold tracking-[-0.02em] text-brass-200 lg:text-[38px]">
                {c.n}
              </span>
              <span class="text-center text-xs text-ash lg:text-base">{c.texto}</span>
            </div>
          ))}
        </div>
      )
    }

    <!-- ── Cómo trabaja ─────────────────────────────────────────────────── -->
    <section class="marco flex flex-col gap-5 py-9 lg:grid lg:grid-cols-[340px_minmax(0,1fr)] lg:items-start lg:gap-18 lg:py-16">
      <div class="flex flex-col gap-1.5">
        <p class="text-xs font-medium tracking-[0.18em] text-brass-600 uppercase">Cómo trabajo</p>
        <h2
          class="font-display text-[28px] leading-[1.04] font-extrabold tracking-[-0.025em] lg:text-[42px]"
        >
          Sin sorpresas, en tres pasos
        </h2>
      </div>
      <ol class="grid list-none gap-5 p-0 lg:grid-cols-3 lg:gap-7">
        {
          PASOS.map((p, i) => (
            <li class="entra flex gap-3.5 lg:flex-col lg:gap-2.5" style={`--i: ${i}`}>
              <span class="font-display text-[22px] leading-none font-extrabold text-brass-400">
                {i + 1}
              </span>
              <div>
                <p class="font-medium lg:text-lg">{p.titulo}</p>
                <p class="mt-0.5 text-sm text-ash lg:text-base">{p.texto}</p>
              </div>
            </li>
          ))
        }
      </ol>
    </section>

    <!-- ── Qué recibes y con qué grabo ──────────────────────────────────── -->
    <section class="marco flex flex-col gap-5 border-y border-line bg-surface py-9 lg:gap-7 lg:py-16">
      <h2 class="font-display text-[26px] leading-tight font-extrabold lg:text-[38px]">
        Lo que te llega al celular
      </h2>
      <ul class="grid list-none gap-3.5 p-0 sm:grid-cols-2 lg:grid-cols-4 lg:gap-4">
        {
          ENTREGABLES.map((e, i) => (
            <li
              class:list={[
                'entra flex flex-col gap-2.5 rounded-card border bg-void p-5',
                'destacado' in e && e.destacado ? 'border-brass-400' : 'border-line',
              ]}
              style={`--i: ${i}`}
            >
              <Icono
                nombre={e.icono as NombreIcono}
                tamano={22}
                grosor={1.8}
                clase="text-brass-400"
              />
              <p class="font-medium">{e.titulo}</p>
              <p class="text-sm text-ash">{e.texto}</p>
            </li>
          ))
        }
      </ul>

      {
        diferenciadores.length > 0 && (
          <ul class="mt-2 flex list-none flex-wrap gap-2.5 p-0">
            {diferenciadores.map((d) => (
              <li class="flex items-center gap-2.5 rounded-control border border-line px-4 py-3">
                <Icono
                  nombre={ICONOS[d.icon ?? ''] ?? 'enlace'}
                  tamano={18}
                  grosor={1.8}
                  clase="text-brass-400"
                />
                <span class="text-sm font-medium">{d.title}</span>
              </li>
            ))}
          </ul>
        )
      }
    </section>

    <!-- ── Lo que ha grabado ────────────────────────────────────────────── -->
    {
      destacadas.length > 0 && (
        <section class="marco flex flex-col gap-4 py-9 lg:gap-7 lg:py-16">
          <div class="flex flex-col gap-1.5 lg:flex-row lg:items-end lg:justify-between lg:gap-10">
            <h2 class="font-display text-[26px] leading-tight font-extrabold lg:text-[38px]">
              Lo que he grabado
            </h2>
            <p class="text-sm text-ash lg:text-right">{PISTAS.galerias}</p>
          </div>
          <div class="grid grid-cols-2 gap-3 lg:grid-cols-4 lg:gap-4">
            {destacadas.map((g, i) => (
              <a
                href={`/trabajos/${g.slug}`}
                class="entra group flex flex-col gap-2"
                style={`--i: ${i}`}
              >
                <div
                  class="relative aspect-9/16 overflow-hidden rounded-card border border-line transition-transform duration-200 group-hover:-translate-y-1"
                  style={`background: ${degradado(g.id)}`}
                >
                  {g.coverUrl && (
                    <img
                      src={src(g.coverUrl)}
                      srcset={srcset(g.coverUrl)}
                      sizes={SIZES.tesela}
                      alt=""
                      loading="lazy"
                      onerror={ESCONDER_SI_FALLA}
                      class="absolute inset-0 h-full w-full object-cover"
                    />
                  )}
                </div>
                <span class="text-sm font-medium">{g.title}</span>
              </a>
            ))}
          </div>
          <a
            href="/trabajos/"
            class="group flex h-12 w-fit items-center gap-2 rounded-control border border-line px-5 text-brass-200 transition-[transform,border-color] duration-150 hover:scale-[1.02] hover:border-brass-400"
          >
            Ver los {galerias.length} trabajos
            <Icono
              nombre="flecha"
              tamano={17}
              clase="transition-transform duration-200 group-hover:translate-x-1"
            />
          </a>
        </section>
      )
    }

    <!-- ── Lo que dicen ─────────────────────────────────────────────────── -->
    {
      testimonios.length > 0 && (
        <section class="marco border-t border-line bg-surface py-9 lg:py-16">
          <Testimonios {testimonios} />
        </section>
      )
    }

    <!-- Cierre. PANEL con margen: a sangre, en claro se lee como fallo de render. -->
    <div class="marco my-8 lg:my-14">
      <section
        class="relative isolate flex flex-col items-center gap-4 overflow-hidden rounded-panel border border-line px-6 py-10 text-center lg:gap-5 lg:px-16 lg:py-16"
        style="background: linear-gradient(160deg, #1e1b18, #0f0d0b); color: #f2efe9"
      >
        <div
          class="aura pointer-events-none absolute -top-44 left-1/2 h-[460px] w-[760px] -translate-x-1/2 rounded-full blur-[30px]"
          style="background: radial-gradient(circle, rgba(37,211,102,.14) 0%, transparent 68%)"
          aria-hidden="true"
        >
        </div>
        <h2
          class="relative font-display text-[28px] leading-tight font-extrabold tracking-[-0.02em] lg:text-[44px]"
          style="color: #f2efe9"
        >
          ¿Qué día es tu evento?
        </h2>
        <p class="relative max-w-[46ch]" style="color: #9c958c">
          Dime la fecha y te confirmo al momento si estoy libre.
        </p>
        <Cta
          {numero}
          {base}
          texto={display}
          fuente="footer"
          clase="relative w-full max-w-sm [&_p]:text-[#9c958c]"
        />
      </section>
    </div>
  </main>

  <Pie {redes} email={ajustes.email} marca={ajustes.brandName} />
  <BarraPegada {numero} {base} />
</Layout>
