---
/**
 * Las tres páginas legales, en un solo fichero.
 *
 * Comparten estructura exacta —titular, entradilla y secciones— así que tres
 * ficheros serían la misma maqueta copiada tres veces, y al retocar una se
 * quedarían dos atrás. El contenido vive en `content/legal.ts`.
 */
import Layout from '../layouts/Layout.astro';
import Barra from '../components/Barra.astro';
import Icono from '../components/Icono.astro';
import Pie from '../components/Pie.astro';
import { LEGALES } from '../content/copy';
import { ACTUALIZADO, LEGALES_DOC, type DocumentoLegal } from '../content/legal';
import { api } from '../lib/api';
import { largo } from '../lib/fechas';

export async function getStaticPaths() {
  const [ajustes, redes] = await Promise.all([api.ajustes(), api.redes()]);
  return LEGALES_DOC.map((doc) => ({
    params: { legal: doc.slug },
    props: { doc, ajustes, redes },
  }));
}

const { doc, ajustes, redes } = Astro.props as {
  doc: DocumentoLegal;
  ajustes: Awaited<ReturnType<typeof api.ajustes>>;
  redes: Awaited<ReturnType<typeof api.redes>>;
};

const numero = ajustes.whatsappNumber;
const base = ajustes.whatsappMessage ?? '';
const display = ajustes.whatsappDisplay ?? numero;

// Con la barra final del `href`: sin ella el filtro no casaba nunca y cada
// documento se enlazaba a sí mismo.
const otros = LEGALES.filter((l) => l.href !== `/${doc.slug}/`);
---

<Layout titulo={`${doc.titulo} · ${ajustes.brandName}`} descripcion={doc.entradilla}>
  <!--
    Sin barra pegada aquí. Un botón verde persiguiendo a quien está leyendo por
    qué puede pedir que le quiten una foto es exactamente el momento de NO
    vender. El WhatsApp sigue en la barra de arriba, que es donde lo va a
    buscar quien viene a pedir justo eso.
  -->
  <Barra {numero} {display} {base} anclas={['/trabajos/', '#paquetes', '/fechas-libres/', '/negocios/', '/sobre-mi/']} prefijo="/" />

  <main id="contenido" class="mx-auto flex max-w-[68ch] flex-col gap-7 px-5 py-7 lg:py-12">
    <div class="flex flex-col gap-3">
      <a href="/" class="flex min-h-12 items-center gap-2 text-ash">
        <Icono nombre="atras" tamano={18} />
        Volver al inicio
      </a>
      <h1
        class="font-display text-[32px] leading-[1.06] font-extrabold tracking-[-0.025em] lg:text-[46px]"
      >
        {doc.titulo}
      </h1>
      <p class="text-ash">{doc.entradilla}</p>
      <p class="text-sm text-brass-600">Actualizado el {largo(ACTUALIZADO)}</p>
    </div>

    {
      doc.secciones.map((s) => (
        <section class="flex flex-col gap-2.5">
          <h2 class="font-display text-[21px] leading-tight font-extrabold lg:text-[26px]">
            {s.titulo}
          </h2>
          {s.parrafos?.map((p) => <p>{p}</p>)}
          {s.lista && (
            <ul class="flex flex-col gap-2">
              {s.lista.map((li) => (
                <li class="flex gap-2.5">
                  <Icono
                    nombre="check"
                    tamano={18}
                    grosor={1.9}
                    clase="mt-1 shrink-0 text-brass-400"
                  />
                  <span>{li}</span>
                </li>
              ))}
            </ul>
          )}
        </section>
      ))
    }

    <nav class="flex flex-col gap-2 border-t border-line pt-6" aria-label="Otros documentos">
      <p class="text-xs font-medium tracking-[0.18em] text-brass-600 uppercase">También</p>
      {
        otros.map((l) => (
          <a href={l.href} class="flex min-h-12 items-center gap-2 text-brass-200">
            {l.texto}
            <Icono nombre="flecha" tamano={17} />
          </a>
        ))
      }
    </nav>
  </main>

  <Pie {redes} email={ajustes.email} marca={ajustes.brandName} />
</Layout>
