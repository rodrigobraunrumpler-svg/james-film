{
  "openapi": "3.0.0",
  "paths": {
    "/categories": {
      "get": {
        "description": "Solo las activas, ordenadas. Sin paginar: son cuatro.",
        "operationId": "CategoriesController_listar",
        "parameters": [],
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "allOf": [
                    {
                      "$ref": "#/components/schemas/ApiSuccessEntity"
                    },
                    {
                      "properties": {
                        "data": {
                          "type": "array",
                          "items": {
                            "$ref": "#/components/schemas/CategoryEntity"
                          }
                        }
                      }
                    }
                  ]
                }
              }
            }
          }
        },
        "summary": "Lista las categorías activas",
        "tags": [
          "categorías"
        ]
      }
    },
    "/galleries": {
      "get": {
        "description": "Solo publicadas y sin borrar. **No devuelve los medios**, solo `mediaCount`: incluirlos haría que el build de Astro se trajera todos los reels de todas las galerías en una respuesta que crece sin techo. Usa el detalle por slug.",
        "operationId": "GalleriesController_listar",
        "parameters": [
          {
            "name": "page",
            "required": false,
            "in": "query",
            "schema": {
              "minimum": 1,
              "default": 1,
              "type": "number"
            }
          },
          {
            "name": "pageSize",
            "required": false,
            "in": "query",
            "schema": {
              "minimum": 1,
              "maximum": 100,
              "default": 20,
              "type": "number"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "allOf": [
                    {
                      "$ref": "#/components/schemas/ApiSuccessEntity"
                    },
                    {
                      "properties": {
                        "data": {
                          "type": "array",
                          "items": {
                            "$ref": "#/components/schemas/GalleryListItemEntity"
                          }
                        },
                        "meta": {
                          "$ref": "#/components/schemas/PaginationMetaEntity"
                        }
                      }
                    }
                  ]
                }
              }
            }
          }
        },
        "summary": "Lista las galerías publicadas",
        "tags": [
          "galerías"
        ]
      }
    },
    "/galleries/{slug}": {
      "get": {
        "description": "Solo los medios en READY. Una galería sin publicar devuelve **404 y no 403**: un 403 confirmaría que ese enlace existe.",
        "operationId": "GalleriesController_porSlug",
        "parameters": [
          {
            "name": "slug",
            "required": true,
            "in": "path",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "allOf": [
                    {
                      "$ref": "#/components/schemas/ApiSuccessEntity"
                    },
                    {
                      "properties": {
                        "data": {
                          "$ref": "#/components/schemas/GalleryEntity"
                        }
                      }
                    }
                  ]
                }
              }
            }
          },
          "404": {
            "description": "No encontrado",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiFailureEntity"
                }
              }
            }
          }
        },
        "summary": "Devuelve una galería publicada con sus medios",
        "tags": [
          "galerías"
        ]
      }
    },
    "/packages": {
      "get": {
        "description": "El destacado sale primero, **sin salirse de la lista**: la landing decide cómo pintarlo.",
        "operationId": "PackagesController_listar",
        "parameters": [],
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "allOf": [
                    {
                      "$ref": "#/components/schemas/ApiSuccessEntity"
                    },
                    {
                      "properties": {
                        "data": {
                          "type": "array",
                          "items": {
                            "$ref": "#/components/schemas/PackageEntity"
                          }
                        }
                      }
                    }
                  ]
                }
              }
            }
          }
        },
        "summary": "Lista los paquetes activos",
        "tags": [
          "paquetes"
        ]
      }
    },
    "/testimonials": {
      "get": {
        "description": "Solo `isActive` **Y `hasConsent`**. `hasConsent` no sale en el contrato: si un testimonio llega aquí, es que ya lo tenía. Ningún parámetro desactiva ese filtro.",
        "operationId": "TestimonialsController_listar",
        "parameters": [
          {
            "name": "galleryId",
            "required": true,
            "in": "query",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "allOf": [
                    {
                      "$ref": "#/components/schemas/ApiSuccessEntity"
                    },
                    {
                      "properties": {
                        "data": {
                          "type": "array",
                          "items": {
                            "$ref": "#/components/schemas/TestimonialEntity"
                          }
                        }
                      }
                    }
                  ]
                }
              }
            }
          }
        },
        "summary": "Lista los testimonios publicables",
        "tags": [
          "testimonios"
        ]
      }
    },
    "/settings": {
      "get": {
        "description": "Registro único. Si no existiera, se crea vacío en vez de devolver 404.",
        "operationId": "SettingsController_leer",
        "parameters": [],
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "allOf": [
                    {
                      "$ref": "#/components/schemas/ApiSuccessEntity"
                    },
                    {
                      "properties": {
                        "data": {
                          "$ref": "#/components/schemas/SiteSettingsEntity"
                        }
                      }
                    }
                  ]
                }
              }
            }
          }
        },
        "summary": "Devuelve los ajustes del sitio",
        "tags": [
          "configuración"
        ]
      }
    },
    "/differentiators": {
      "get": {
        "operationId": "SettingsController_diferenciadores",
        "parameters": [],
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "allOf": [
                    {
                      "$ref": "#/components/schemas/ApiSuccessEntity"
                    },
                    {
                      "properties": {
                        "data": {
                          "type": "array",
                          "items": {
                            "$ref": "#/components/schemas/DifferentiatorEntity"
                          }
                        }
                      }
                    }
                  ]
                }
              }
            }
          }
        },
        "summary": "Lista los diferenciadores activos",
        "tags": [
          "configuración"
        ]
      }
    },
    "/social-links": {
      "get": {
        "operationId": "SettingsController_redes",
        "parameters": [],
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "allOf": [
                    {
                      "$ref": "#/components/schemas/ApiSuccessEntity"
                    },
                    {
                      "properties": {
                        "data": {
                          "type": "array",
                          "items": {
                            "$ref": "#/components/schemas/SocialLinkEntity"
                          }
                        }
                      }
                    }
                  ]
                }
              }
            }
          }
        },
        "summary": "Lista las redes activas",
        "tags": [
          "configuración"
        ]
      }
    },
    "/availability": {
      "get": {
        "description": "Lo hornea el build de Astro. **Por defecto todo está libre**: se guardan los días ocupados, nunca los libres, así que con la tabla vacía el año entero sale libre y es verdad.\n\n**No acepta ningún parámetro**, y es a propósito: un endpoint público que no recibe nada no se puede filtrar mal. Y **nunca lleva la nota** — es información de un cliente que no dio permiso para publicarla (Ley 29733). En la web un día ocupado dice «ocupado» y nada más.\n\n`until` es imprescindible: sin él la landing no puede distinguir «libre» de «no lo sé», y un día a catorce meses saldría libre.",
        "operationId": "AvailabilityController_publica",
        "parameters": [],
        "responses": {
          "204": {
            "description": "Sin contenido"
          }
        },
        "summary": "Los días ocupados de los próximos 12 meses",
        "tags": [
          "availability"
        ]
      }
    },
    "/track/whatsapp": {
      "post": {
        "description": "El clic a WhatsApp **es** el lead: no hay formulario de contacto (§1 §9). Devuelve 204 y no bloquea nada — la landing lo manda con `sendBeacon` y se va a WhatsApp sin esperar.\n\nUn `packageId` que ya no existe **no tumba el clic**: se guarda sin atribución. Perder de qué paquete venía es barato; perder el clic no.",
        "operationId": "TrackingController_clic",
        "parameters": [],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/TrackClickDto"
              }
            }
          }
        },
        "responses": {
          "204": {
            "description": "Sin contenido"
          },
          "422": {
            "description": "La validación del DTO falló. Mira `details` para el campo concreto.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiFailureEntity"
                }
              }
            }
          }
        },
        "summary": "Registra un clic al botón de WhatsApp",
        "tags": [
          "tracking"
        ]
      }
    }
  },
  "info": {
    "title": "James Film · API pública",
    "description": "Lo que consume la landing de Astro en build time. Toda respuesta va envuelta en `{ success, code, data, meta?, timestamp }`.",
    "version": "1.0",
    "contact": {}
  },
  "tags": [],
  "servers": [],
  "components": {
    "schemas": {
      "ApiSuccessEntity": {
        "type": "object",
        "properties": {
          "success": {
            "type": "boolean",
            "example": true
          },
          "code": {
            "type": "string",
            "example": "OK"
          },
          "timestamp": {
            "type": "string",
            "example": "2026-08-28T16:40:12.031Z"
          }
        },
        "required": [
          "success",
          "code",
          "timestamp"
        ]
      },
      "PaginationMetaEntity": {
        "type": "object",
        "properties": {
          "totalCount": {
            "type": "number",
            "example": 47
          },
          "pageCount": {
            "type": "number",
            "example": 3
          },
          "currentPage": {
            "type": "number",
            "example": 2
          },
          "pageSize": {
            "type": "number",
            "example": 20
          },
          "isFirstPage": {
            "type": "boolean"
          },
          "isLastPage": {
            "type": "boolean"
          },
          "previousPage": {
            "type": "number",
            "nullable": true,
            "example": 1
          },
          "nextPage": {
            "type": "number",
            "nullable": true,
            "example": 3
          }
        },
        "required": [
          "totalCount",
          "pageCount",
          "currentPage",
          "pageSize",
          "isFirstPage",
          "isLastPage",
          "previousPage",
          "nextPage"
        ]
      },
      "CategoryEntity": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "slug": {
            "type": "string",
            "example": "bodas"
          },
          "name": {
            "type": "string",
            "example": "Bodas"
          },
          "tagline": {
            "type": "string",
            "nullable": true
          },
          "description": {
            "type": "string",
            "nullable": true
          },
          "coverUrl": {
            "type": "string",
            "nullable": true
          }
        },
        "required": [
          "id",
          "slug",
          "name",
          "tagline",
          "description",
          "coverUrl"
        ]
      },
      "FieldErrorEntity": {
        "type": "object",
        "properties": {
          "field": {
            "type": "string",
            "example": "items.0.text"
          },
          "code": {
            "type": "string",
            "example": "isNotEmpty"
          },
          "message": {
            "type": "string",
            "example": "No puede estar vacío"
          }
        },
        "required": [
          "field",
          "code",
          "message"
        ]
      },
      "ApiFailureEntity": {
        "type": "object",
        "properties": {
          "success": {
            "type": "boolean",
            "example": false
          },
          "statusCode": {
            "type": "number",
            "example": 409
          },
          "code": {
            "type": "string",
            "enum": [
              "VALIDATION_FAILED",
              "UNAUTHORIZED",
              "FORBIDDEN",
              "NOT_FOUND",
              "CONFLICT",
              "RATE_LIMITED",
              "INTERNAL",
              "INVALID_CREDENTIALS",
              "SESSION_EXPIRED",
              "SESSION_REVOKED",
              "SLUG_TAKEN",
              "CATEGORY_IN_USE",
              "CONSENT_REQUIRED",
              "UNSUPPORTED_MEDIA_TYPE",
              "FILE_TOO_LARGE",
              "UPLOAD_SIZE_MISMATCH"
            ],
            "example": "SLUG_TAKEN",
            "description": "El contrato. El mensaje puede cambiar; esto no."
          },
          "message": {
            "type": "string",
            "example": "Ya existe una galería con ese enlace"
          },
          "details": {
            "description": "Solo en VALIDATION_FAILED",
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/FieldErrorEntity"
            }
          },
          "requestId": {
            "type": "string",
            "example": "01JD4X…"
          },
          "timestamp": {
            "type": "string"
          }
        },
        "required": [
          "success",
          "statusCode",
          "code",
          "message",
          "timestamp"
        ]
      },
      "CategoryRefEntity": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "slug": {
            "type": "string",
            "example": "bodas"
          },
          "name": {
            "type": "string",
            "example": "Bodas"
          }
        },
        "required": [
          "id",
          "slug",
          "name"
        ]
      },
      "GalleryListItemEntity": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "slug": {
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "eventDate": {
            "type": "string",
            "nullable": true,
            "example": "2026-03-15"
          },
          "location": {
            "type": "string",
            "nullable": true
          },
          "coverUrl": {
            "type": "string",
            "nullable": true
          },
          "isFeatured": {
            "type": "boolean"
          },
          "category": {
            "$ref": "#/components/schemas/CategoryRefEntity"
          },
          "mediaCount": {
            "type": "number",
            "description": "La lista NO trae los medios: solo cuántos hay listos.",
            "example": 3
          },
          "photoCount": {
            "type": "number",
            "example": 3,
            "description": "Cuántos de esos medios son fotos. Los vídeos son la resta."
          }
        },
        "required": [
          "id",
          "slug",
          "title",
          "eventDate",
          "location",
          "coverUrl",
          "isFeatured",
          "category",
          "photoCount"
        ]
      },
      "MediaEntity": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "type": {
            "type": "string",
            "enum": [
              "REEL",
              "AFTERMOVIE",
              "PHOTO"
            ]
          },
          "orientation": {
            "type": "string",
            "enum": [
              "VERTICAL",
              "HORIZONTAL",
              "SQUARE"
            ]
          },
          "url": {
            "type": "string",
            "description": "URL absoluta. En la base se guarda la key, nunca esto."
          },
          "posterUrl": {
            "type": "string",
            "nullable": true
          },
          "width": {
            "type": "number",
            "nullable": true,
            "example": 1080
          },
          "height": {
            "type": "number",
            "nullable": true,
            "example": 1920
          },
          "durationSec": {
            "type": "number",
            "nullable": true,
            "example": 45
          },
          "alt": {
            "type": "string",
            "nullable": true
          },
          "caption": {
            "type": "string",
            "nullable": true
          },
          "order": {
            "type": "number"
          },
          "isFeatured": {
            "type": "boolean",
            "description": "La portada. Exclusiva por galería."
          }
        },
        "required": [
          "id",
          "type",
          "orientation",
          "url",
          "posterUrl",
          "width",
          "height",
          "durationSec",
          "alt",
          "caption",
          "order",
          "isFeatured"
        ]
      },
      "GalleryEntity": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "slug": {
            "type": "string",
            "example": "xv-de-camila"
          },
          "title": {
            "type": "string",
            "example": "XV de Camila"
          },
          "description": {
            "type": "string",
            "nullable": true
          },
          "eventDate": {
            "type": "string",
            "nullable": true,
            "example": "2026-03-15",
            "description": "Fecha de calendario, sin hora. Formatear con timeZone UTC."
          },
          "location": {
            "type": "string",
            "nullable": true
          },
          "coverUrl": {
            "type": "string",
            "nullable": true
          },
          "isFeatured": {
            "type": "boolean"
          },
          "category": {
            "$ref": "#/components/schemas/CategoryRefEntity"
          },
          "media": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/MediaEntity"
            }
          }
        },
        "required": [
          "id",
          "slug",
          "title",
          "description",
          "eventDate",
          "location",
          "coverUrl",
          "isFeatured",
          "category",
          "media"
        ]
      },
      "PackageItemEntity": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "text": {
            "type": "string",
            "example": "7 reels editados"
          },
          "included": {
            "type": "boolean",
            "description": "false = se muestra tachado."
          }
        },
        "required": [
          "id",
          "text",
          "included"
        ]
      },
      "PackageEntity": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "slug": {
            "type": "string",
            "example": "pro"
          },
          "name": {
            "type": "string",
            "example": "Pro"
          },
          "subtitle": {
            "type": "string",
            "nullable": true
          },
          "priceAmount": {
            "type": "number",
            "nullable": true,
            "example": 30000,
            "description": "CÉNTIMOS. S/ 300 son 30000. Formatear con Intl.NumberFormat."
          },
          "currency": {
            "type": "string",
            "example": "PEN"
          },
          "priceNote": {
            "type": "string",
            "nullable": true
          },
          "idealFor": {
            "type": "string",
            "nullable": true
          },
          "icon": {
            "type": "string",
            "nullable": true,
            "description": "Nombre lucide de lista cerrada."
          },
          "imageUrl": {
            "type": "string",
            "nullable": true
          },
          "badgeText": {
            "type": "string",
            "nullable": true
          },
          "whatsappMessage": {
            "type": "string",
            "nullable": true
          },
          "isHighlighted": {
            "type": "boolean",
            "description": "Solo uno puede estar en true. Lo fuerza la API."
          },
          "items": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/PackageItemEntity"
            }
          }
        },
        "required": [
          "id",
          "slug",
          "name",
          "subtitle",
          "priceAmount",
          "currency",
          "priceNote",
          "idealFor",
          "icon",
          "imageUrl",
          "badgeText",
          "whatsappMessage",
          "isHighlighted",
          "items"
        ]
      },
      "TestimonialEntity": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "format": {
            "type": "string",
            "enum": [
              "TEXT",
              "SCREENSHOT"
            ]
          },
          "source": {
            "type": "string",
            "enum": [
              "WHATSAPP",
              "INSTAGRAM",
              "TIKTOK",
              "DIRECTO"
            ]
          },
          "authorName": {
            "type": "string"
          },
          "authorHandle": {
            "type": "string",
            "nullable": true
          },
          "avatarUrl": {
            "type": "string",
            "nullable": true
          },
          "eventType": {
            "type": "string",
            "nullable": true
          },
          "eventDate": {
            "type": "string",
            "nullable": true,
            "example": "2026-03-15",
            "description": "Fecha de calendario. Formatear con timeZone UTC."
          },
          "quote": {
            "type": "string",
            "nullable": true
          },
          "screenshotUrl": {
            "type": "string",
            "nullable": true
          },
          "externalUrl": {
            "type": "string",
            "nullable": true
          },
          "rating": {
            "type": "number",
            "nullable": true,
            "minimum": 1,
            "maximum": 5
          },
          "galleryId": {
            "type": "string",
            "nullable": true
          }
        },
        "required": [
          "id",
          "format",
          "source",
          "authorName",
          "authorHandle",
          "avatarUrl",
          "eventType",
          "eventDate",
          "quote",
          "screenshotUrl",
          "externalUrl",
          "rating",
          "galleryId"
        ]
      },
      "SiteSettingsEntity": {
        "type": "object",
        "properties": {
          "brandName": {
            "type": "string",
            "example": "James Film"
          },
          "role": {
            "type": "string",
            "nullable": true
          },
          "tagline": {
            "type": "string",
            "nullable": true
          },
          "slogan": {
            "type": "string",
            "nullable": true
          },
          "aboutText": {
            "type": "string",
            "nullable": true,
            "description": "Markdown con SOLO negrita. Se renderiza en build time."
          },
          "photoUrl": {
            "type": "string",
            "nullable": true
          },
          "logoUrl": {
            "type": "string",
            "nullable": true
          },
          "signatureUrl": {
            "type": "string",
            "nullable": true
          },
          "whatsappNumber": {
