// ============================================================
//  JAMES FILM — Schema Prisma (PostgreSQL)
//  Base: docs/proyecto.md §13 · Deltas: CLAUDE.md §3
//  14 modelos + 1 pivote · 8 enums
// ============================================================

// Prisma 7: la conexión NO va aquí, va en prisma7.config.ts (que usa DIRECT_URL).
// El cliente de runtime recibe DATABASE_URL vía driver adapter en PrismaService.
generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ------------------------------------------------------------
//  CATEGORÍAS
// ------------------------------------------------------------

model Category {
  id          String  @id @default(cuid())
  slug        String  @unique
  name        String
  tagline     String?
  description String? @db.Text

  coverKey String? // key de R2, no relación: evita el ciclo Category→Media→Gallery→Category

  order    Int     @default(0)
  isActive Boolean @default(true)

  metaTitle       String?
  metaDescription String?

  galleries Gallery[]
  packages  PackageCategory[]
  leads     Lead[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([isActive, order])
}

// ------------------------------------------------------------
//  GALERÍAS — un evento cubierto ("XV de Camila")
// ------------------------------------------------------------

model Gallery {
  id          String  @id @default(cuid())
  slug        String  @unique // se genera al crear y NO se regenera al renombrar
  title       String
  description String? @db.Text

  eventDate DateTime? @db.Date // una fecha, no un instante. Formatear con timeZone: 'UTC'
  location  String?

  isPublished Boolean @default(false)
  isFeatured  Boolean @default(false)
  order       Int     @default(0)

  /// Hay una hoja de autorización de imagen FIRMADA para este evento.
  ///
  /// Nace en `false` y bloquea la publicación, igual que `Testimonial.hasConsent`:
  /// en una galería salen caras de gente real y en los XV años salen MENORES, así
  /// que publicar era un botón sin fricción sobre lo único que puede traerle un
  /// problema de verdad a James (Ley 29733 y art. 15 del Código Civil).
  ///
  /// El booleano **no acredita nada por sí solo** — lo que acredita es la hoja
  /// firmada, que vive fuera del sistema (`docs/legal/`). Esto es el recordatorio
  /// de haberla pedido, y la puerta que obliga a pararse a pensarlo.
  ///
  /// Sin `consentAt` ni `consentBy`: son columnas para un usuario único que puede
  /// anotar la fecha en la propia hoja. La que hace falta es esta.
  hasConsent Boolean @default(false)

  deletedAt DateTime? // soft delete: el cron limpia R2 a los 30 días

  categoryId String
  category   Category @relation(fields: [categoryId], references: [id], onDelete: Restrict)

  media        Media[]
  testimonials Testimonial[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([categoryId, isPublished, order])
  @@index([isFeatured, isPublished])
  @@index([deletedAt])
}

// ------------------------------------------------------------
//  MEDIA — reels, aftermovies y fotos
// ------------------------------------------------------------

enum MediaType {
  REEL
  AFTERMOVIE
  PHOTO
}

enum Orientation {
  VERTICAL
  HORIZONTAL
  SQUARE
}

enum MediaStatus {
  PENDING
  READY
  FAILED
}

model Media {
  id          String      @id @default(cuid())
  type        MediaType
  orientation Orientation @default(VERTICAL) // se deriva de width/height en el confirm
  status      MediaStatus @default(PENDING)

  storageKey String  @unique // "videos/uuid.mp4" — SIEMPRE la key, nunca la URL
  posterKey  String? // frame extraído en el navegador

  mimeType    String
  sizeBytes   Int
  width       Int?
  height      Int?
  durationSec Int?

  error    String? // qué falló: sin esto el aviso del dashboard es inútil
  attempts Int     @default(0)

  clientUploadId String? // idempotencia del presign, sin tabla de claves

  alt        String?
  caption    String?
  order      Int     @default(0)
  isFeatured Boolean @default(false) // portada, exclusiva POR GALERÍA

  deletedAt DateTime?

  galleryId String
  gallery   Gallery @relation(fields: [galleryId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([galleryId, clientUploadId])
  @@index([galleryId, order])
  @@index([status])
  @@index([type, isFeatured])
  @@index([deletedAt])
}

// ------------------------------------------------------------
//  PAQUETES — Básico S/300 · Pro S/600 · Premium S/900
// ------------------------------------------------------------

model Package {
  id       String  @id @default(cuid())
  slug     String  @unique
  name     String
  subtitle String?

  priceAmount Int? // CÉNTIMOS: S/300 → 30000
  currency    String  @default("PEN")
  priceNote   String?

  idealFor String?

  icon        String? // nombre lucide de la lista cerrada de copy.ts
  imageKey    String? // foto de fondo de la tarjeta
  accentColor String? // se guarda y se edita; la web v1 NO lo consume
  badgeText   String? // "NUESTRO MÁS VENDIDO"

  whatsappMessage String?

  isHighlighted Boolean @default(false) // exclusivo, forzado en la API
  isActive      Boolean @default(true)
  order         Int     @default(0)

  items          PackageItem[]
  categories     PackageCategory[]
  leads          Lead[]
  whatsappClicks WhatsappClick[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([isActive, order])
}

model PackageCategory {
  packageId  String
  categoryId String

  package  Package  @relation(fields: [packageId], references: [id], onDelete: Cascade)
  category Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@id([packageId, categoryId])
}

model PackageItem {
  id       String  @id @default(cuid())
  text     String
  included Boolean @default(true)
  order    Int     @default(0)

  packageId String
  package   Package @relation(fields: [packageId], references: [id], onDelete: Cascade)

  @@index([packageId, order])
}

// ------------------------------------------------------------
//  DIFERENCIADORES — la fila de 4 íconos del flyer
// ------------------------------------------------------------

model Differentiator {
  id       String  @id @default(cuid())
  title    String  @unique
  subtitle String?
  icon     String
  order    Int     @default(0)
  isActive Boolean @default(true)

  @@index([isActive, order])
}

// ------------------------------------------------------------
//  REDES SOCIALES — tabla propia. WhatsApp NO va aquí
// ------------------------------------------------------------

model SocialLink {
  id       String  @id @default(cuid())
  platform String  @unique // String, no enum: una red nueva no debe migrar la base
  handle   String
  url      String // completa, no se arma desde el handle
  icon     String?
  order    Int     @default(0)
  isActive Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([isActive, order])
}

// ------------------------------------------------------------
//  TRACKING — el clic a WhatsApp ES el lead
// ------------------------------------------------------------

model WhatsappClick {
  id String @id @default(cuid())

  packageId String?
  package   Package? @relation(fields: [packageId], references: [id], onDelete: SetNull)

  /// De dónde salió el clic. La lista buena es `FUENTES` en
  /// `tracking/dto/track-click.dto.ts`: escribirla aquí a mano garantiza que se
  /// quede atrás, y ya pasó — este comentario omitía `galeria` desde hace meses.
  source String?

  /// QUÉ DÍA preguntaba, cuando el clic sale del calendario.
  ///
  /// Es fecha de calendario, no instante. Sin esto se sabía CUÁNTA gente
  /// escribe por un día que ya está cogido, pero no CUÁL — y ese es justo el
  /// dato accionable: «el 24 de octubre te lo han pedido tres veces» decide si
  /// James sube el precio ese finde, busca apoyo o le escribe él primero.
  ///
  /// La landing ya lo sabía —lo escribe dentro del mensaje de WhatsApp— y lo
  /// tiraba. Anulable porque los clics del hero, los paquetes o el pie no
  /// preguntan por ninguna fecha.
  requestedDate DateTime? @db.Date

  createdAt DateTime @default(now())

  @@index([createdAt])
  /// Para «las fechas más pedidas»: el filtro es siempre fuente + ventana.
  @@index([source, requestedDate])
}

// ------------------------------------------------------------
//  TESTIMONIOS
// ------------------------------------------------------------

enum TestimonialFormat {
  TEXT
  SCREENSHOT
}

enum TestimonialSource {
  WHATSAPP
  INSTAGRAM
  TIKTOK
  DIRECTO
}

model Testimonial {
  id     String            @id @default(cuid())
  format TestimonialFormat @default(SCREENSHOT)
  source TestimonialSource @default(WHATSAPP)

  authorName   String
  authorHandle String?
  avatarKey    String?
  eventType    String?
  eventDate    DateTime? @db.Date

  quote         String? @db.Text
  screenshotKey String?
  externalUrl   String?

  rating Int?

  galleryId String?
  gallery   Gallery? @relation(fields: [galleryId], references: [id], onDelete: SetNull)

  hasConsent Boolean @default(false) // NO publicar si es false — Ley 29733
  isActive   Boolean @default(false) // nace borrador: nunca publicable sin consentimiento explícito
  isFeatured Boolean @default(false)
  order      Int     @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([isActive, order])
  @@index([galleryId, isActive, order])
}

// ------------------------------------------------------------
//  LEADS — fuera del v1. La tabla existe vacía a propósito
// ------------------------------------------------------------

enum LeadStatus {
  NEW
  CONTACTED
  QUOTED
  WON
  LOST
}

model Lead {
  id      String  @id @default(cuid())
  name    String
  phone   String
  email   String?
  message String? @db.Text

  eventDate DateTime? @db.Date

  categoryId String?
  category   Category? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  packageId  String?
  package    Package?  @relation(fields: [packageId], references: [id], onDelete: SetNull)

  status LeadStatus @default(NEW)
  notes  String?    @db.Text

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status, createdAt])
}

// ------------------------------------------------------------
//  CONFIGURACIÓN DEL SITIO (fila única)
// ------------------------------------------------------------

model SiteSettings {
  id String @id @default("singleton")

  /// Cuándo tocó James el calendario por última vez, para el «actualizado hace
  /// 2 días» de la web. **No se deriva de `max(BusyDay.updatedAt)`**: desmarcar
  /// BORRA filas, así que si la más reciente era la que se quitó, ese máximo
  /// RETROCEDE y la web diría «actualizado hace un mes» justo después de que lo
  /// tocara. Y esa frase es una promesa: si retrocede, miente en la dirección
  /// peor. Es el instante de la ACCIÓN, no el de las filas.
  availabilityUpdatedAt DateTime?

  brandName String  @default("James Film")
  role      String?
  tagline   String?
  slogan    String?
  aboutText String? @db.Text // Markdown: el resaltado dorado del flyer

  /// SU CARA, y NO el logo. Estaban compartiendo hueco: «Sobre mí» pintaba
  /// `logoUrl` en el círculo de la foto, o sea una tira de película donde va
  /// una persona. Son dos cosas distintas y ninguna sustituye a la otra —
  /// quien contrata a alguien para diez horas dentro de la boda de su hija
  /// quiere verle la cara.
  photoKey     String?
  logoKey      String? // tira de película estilizada
  signatureKey String? // firma manuscrita, SVG

  whatsappNumber  String? // internacional SIN el +: "51994724944"
  whatsappDisplay String?
  whatsappMessage String?
  ctaText         String?

  email String?

  heroMediaKey  String?
  heroPosterKey String?

  footerTagline String?

  metaTitle       String?
  metaDescription String?
  ogImageKey      String?

  updatedAt DateTime @updatedAt
}

// ------------------------------------------------------------
//  USUARIOS Y SESIONES
// ------------------------------------------------------------

enum Role {
  ADMIN
  EDITOR
}

model User {
  id           String  @id @default(cuid())
  email        String  @unique
  passwordHash String
  name         String
  role         Role    @default(EDITOR)
  isActive     Boolean @default(true)

  sessions Session[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// Rotación de refresh con detección de reuso. Una fila por login, no crece.
// SHA-256, nunca argon2: argon2 lleva sal y `WHERE tokenHash = ?` no encontraría nada.
model Session {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  tokenHash String  @unique // SHA-256 del refresh vigente
  prevHash  String? @unique // SHA-256 del anterior → detecta reuso

  expiresAt DateTime
  revokedAt DateTime?
  userAgent String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
}

// ------------------------------------------------------------
//  ESTADO DE PUBLICACIÓN
//  Tabla aparte: en SiteSettings el deploy se mordería la cola
// ------------------------------------------------------------

enum DeployStatus {
  IDLE
  QUEUED
  BUILDING
  SUCCESS
  FAILED
}

model DeployState {
  id             String       @id @default("singleton")
  pendingChanges Int          @default(0) // "3 cambios sin publicar"
  status         DeployStatus @default(IDLE)
  deploymentId   String? // id que devuelve el deploy hook
  triggeredAt    DateTime?
  finishedAt     DateTime?
  error          String?
  updatedAt      DateTime     @updatedAt
}

// ------------------------------------------------------------
//  DISPONIBILIDAD — qué días NO tiene libres
// ------------------------------------------------------------

/// Un día que James NO tiene libre. Lo que no está aquí, está libre: se guarda
/// la EXCEPCIÓN, no la norma. Con la tabla vacía el año entero sale libre, que
/// es lo correcto y lo que no exige mantenimiento. Al revés, un mes que no
/// hubiera tocado saldría sin disponibilidad y dejaría la web peor que sin
/// calendario.
model BusyDay {
  id String @id @default(cuid())

  /// Fecha de calendario, no instante. `@unique` hace el marcado idempotente
  /// —marcar dos veces el mismo día no puede crear dos filas— y es además el
  /// índice por el que se consulta siempre, que es un rango entre dos fechas.
  /// Sin `@@index([date])`: el `@unique` ya lo crea, y declarar los dos deja un
  /// índice duplicado que Postgres mantiene en cada escritura para nada.
  date DateTime @unique @db.Date

  /// PRIVADA. Solo la ve James en el panel; el DTO público no la expone nunca —
  /// es información de un cliente que no ha dado permiso (Ley 29733).
  note String?

  /// Los días marcados A LA VEZ comparten grupo: «24 y 25 de octubre» es UNA
  /// boda, no dos. Cuando James los marca el sistema YA sabe que van juntos;
  /// reconstruirlo después adivinando —«días seguidos con la misma nota»—
  /// fallaría justo en el caso real de un sábado de boda seguido de un domingo
  /// de cumpleaños. Nullable: un día suelto no necesita grupo.
  groupId String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([groupId])
}
