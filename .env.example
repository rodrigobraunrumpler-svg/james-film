NODE_ENV=development
PORT=3000

# Local (Docker). En Neon estas dos difieren: url lleva -pooler, directUrl no.
DATABASE_URL="postgresql://jamesfilm:jamesfilm@localhost:5433/jamesfilm?schema=public"
DIRECT_URL="postgresql://jamesfilm:jamesfilm@localhost:5433/jamesfilm?schema=public"

# Usuario admin que crea el seed. Nunca hardcodear.
SEED_ADMIN_EMAIL="javier.fullstack.qr@gmail.com"
SEED_ADMIN_PASSWORD="cambiar-esto-en-produccion"

# Clics de ejemplo para que el panel tenga forma en local y en el E2E.
# NUNCA en producción: el clic a WhatsApp es la única métrica del negocio y uno
# inventado la deja sin valor. Se salta solo si ya hay clics registrados.
SEED_DEMO_CLICKS=true

# --- Auth ---
JWT_SECRET="genera-uno-con-openssl-rand-hex-32"
JWT_ACCESS_TTL_SECONDS=900
REFRESH_TTL_DAYS=30
REFRESH_GRACE_SECONDS=30
RATE_LIMIT_ENABLED=true

# --- Almacenamiento (MinIO en local, R2 en producción) ---
S3_ENDPOINT="http://localhost:9000"
S3_REGION="us-east-1"
S3_BUCKET="jamesfilm"
S3_ACCESS_KEY_ID="jamesfilm"
S3_SECRET_ACCESS_KEY="jamesfilm-secreto"
S3_FORCE_PATH_STYLE=true
CDN_BASE_URL="http://localhost:9000/jamesfilm"

# ── La LANDING ────────────────────────────────────────────────────────────────
# Las dos variables que deciden si el despliegue funciona, y no estaban aquí.
#
# Van en las variables del build de Cloudflare Pages, no solo en local: el build
# de Astro las empotra en el HTML. Con `PUBLIC_API_URL` sin definir, el clic a
# WhatsApp —la única métrica del negocio— se manda a `localhost` y el CSP lo
# bloquea; y con `CDN_BASE_URL` apuntando a otro host que el que declara
# `apps/web/public/_headers`, todas las imágenes se bloquean y el portafolio se
# ve VACÍO. Las dos cosas fallan en silencio, y por eso `astro.config.mjs` tiene
# un guardia que aborta el build en Pages si no cuadran.
PUBLIC_SITE_URL="http://localhost:4321"
PUBLIC_API_URL="http://localhost:3000"
MAX_VIDEO_MB=200
MAX_IMAGE_MB=15
PRESIGN_TTL_SECONDS=3600
# Techo informativo del medidor del sidebar. El plan gratuito de R2 son 10 GB.
STORAGE_QUOTA_GB=10

# --- Admin (pasarela) ---
API_URL="http://localhost:3000"
API_TIMEOUT_MS=15000

# La landing pública. La usa el admin para el botón «Ver en la web».
# En desarrollo, el puerto de Astro. En producción, el dominio de James — que
# sigue en los pendientes de CLAUDE.md.
NEXT_PUBLIC_WEB_URL="http://localhost:4321"

# Orígenes de la LANDING que pueden llamar a la API desde el navegador (coma).
# Solo lo necesita POST /track/whatsapp: el clic lo registra el visitante.
WEB_ORIGIN=http://localhost:4321
